{
  "name": "@nguyenetic/nexusql",
  "version": "2.7.0",
  "description": "AI-Native, PostgreSQL-compatible database with vector search support. Embedded, fast, and easy to use. Now with parameterized queries for SQL injection prevention!",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "nexusql",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "npm run build:native && tsc",
    "build:native": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:ts": "tsc",
    "test": "jest",
    "prepublish": "npm run build",
    "universal": "napi universal",
    "version": "napi version"
  },
  "keywords": [
    "database",
    "postgresql",
    "sql",
    "embedded",
    "ai-native",
    "vector-search",
    "vector-database",
    "pgvector",
    "hnsw",
    "semantic-search",
    "embeddings",
    "full-text-search",
    "distributed",
    "file-based",
    "rust",
    "mcp",
    "batch-operations",
    "high-performance",
    "parameterized-queries",
    "sql-injection-prevention",
    "security"
  ],
  "author": "John Nguyen <john@nexusql.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nguyenetic/NexusQL.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Nguyenetic/NexusQL/issues"
  },
  "homepage": "https://github.com/Nguyenetic/NexusQL#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@napi-rs/cli": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  },
  "files": [
    "dist",
    "nexusql.*.node",
    "README.md",
    "LICENSE"
  ]
}
